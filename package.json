{
  "name": "fcmediaagent-replica",
  "private": true,
  "version": "0.1.26",
  "description": "中科元晟 AI 员工 复刻版（NestJS + Prisma + Electron + openclaw 网关）",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev:server": "npm -w packages/server run start:dev",
    "dev:desktop": "npm -w packages/desktop run dev",
    "db:generate": "npm -w packages/server run prisma:generate",
    "db:migrate": "npm -w packages/server run prisma:migrate",
    "db:seed": "npm -w packages/server run prisma:seed"
  }
}
