# ---- 基础 ----
PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://fcm:CHANGE_ME@127.0.0.1:3306/fcmediaagent_v2"
JWT_SECRET=CHANGE_ME_32_CHARS
