ALIYUN_SMS_TEMPLATE_CODE=SMS_512280223
ALIYUN_SMS_REGION=cn-hangzhou
# ---- OSS ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=zhongke001
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# ---- 微信支付 ----
WECHAT_PAY_APP_ID=wx219da5e18416b3fd
WECHAT_PAY_MCH_ID=1118595998
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.fcmediaagent.com/api/payments/wechat/notify
# ---- 模型（官方直连）----
# ---- 模型供应商（W2）----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MOONSHOT_API_KEY=
# ---- 第三方媒体云（RunningHub 兼容适配层）----
RUNNINGHUB_BASE_URL=
RUNNINGHUB_API_KEY=
RUNNINGHUB_API_ID=2031016553440878594
# 对口型（MuseTalk/lipsync）AI App
RUNNINGHUB_API_ID_LIPSYNC=2031016553440878594
# 音色克隆（indextts）AI App
RUNNINGHUB_API_ID_INDEXTTS=1965614643077070850
# 混剪（smart_clip：broadcast_mixcut / news_mixcut / realman_broadcast）AI App
RUNNINGHUB_API_ID_SMART_CLIP=2096795601945350145
# 文生图（image_gen）AI App：6=提示词 625=尺寸档位
RUNNINGHUB_API_ID_IMAGE=1980546294345285634
# 图生视频（video_gen）AI App：135=首帧图 107=时长 153=高清/速度 113=比例 247=画幅 272=文本方式 116=提示词
RUNNINGHUB_API_ID_VIDEO=1950219582398185474
# ---- RunningHub 工作流节点号（默认值即线上 AI App 的实际节点）----
# lipsync：image/audio/seconds/start/prompt/resolution/fps
RUNNINGHUB_NODE_IMAGE=444
RUNNINGHUB_NODE_AUDIO=1755
RUNNINGHUB_NODE_SECONDS=1583
RUNNINGHUB_NODE_START=1776
RUNNINGHUB_NODE_PROMPT=1624
RUNNINGHUB_NODE_RESOLUTION=1606
RUNNINGHUB_NODE_FPS=1586
# 文生图（image_gen）：prompt/size
RUNNINGHUB_NODE_IMG_PROMPT=6
RUNNINGHUB_NODE_IMG_SIZE=625
# 图生视频（video_gen）：image/seconds/version/ratio/aspect/textMode/prompt
RUNNINGHUB_NODE_VID_IMAGE=135
RUNNINGHUB_NODE_VID_SECONDS=107
RUNNINGHUB_NODE_VID_VERSION=153
RUNNINGHUB_NODE_VID_RATIO=113
RUNNINGHUB_NODE_VID_ASPECT=247
RUNNINGHUB_NODE_VID_ASPECT_DEFAULT=4
RUNNINGHUB_NODE_VID_TEXTMODE=272
RUNNINGHUB_NODE_VID_PROMPT=116
# indextts：13=被模仿音频 15=情感参考音频 14=要合成的文本
RUNNINGHUB_NODE_TTS_AUDIO=13
RUNNINGHUB_NODE_TTS_EMOTION=15
RUNNINGHUB_NODE_TTS_TEXT=14
# smart_clip：114=参考图 224=提示词 115=画幅/像素 135=时长（秒）
RUNNINGHUB_NODE_CLIP_IMAGE=114
RUNNINGHUB_NODE_CLIP_PROMPT=224
RUNNINGHUB_NODE_CLIP_ASPECT=115
RUNNINGHUB_NODE_CLIP_SECONDS=135
RUNNINGHUB_WEBHOOK_SECRET=
RUNNINGHUB_WEBHOOK_URL=
# 媒体账号限额：每天按北京时间 00:00 重置；仅配置正整数
MEDIA_DAILY_LIMIT=50
MEDIA_DAILY_SECONDS_LIMIT=600
MEDIA_CONCURRENT_LIMIT=3
# ---- 个人微信 UIAutomation bridge（桌面端本地服务）----
WECHAT_UIA_BASE_URL=
WECHAT_UIA_TOKEN=
WECHAT_UIA_CURRENT_CHAT=
WECHAT_UIA_ALLOW_UNVERIFIED_CURRENT_CHAT=false
WECHAT_UIA_PORT=18990
# 个人微信「自动接管」：逗号分隔的会话名（微信昵称/备注），为空则不接管只保留手动接口
WECHAT_PERSONAL_CHATS=
# 入站轮询间隔毫秒（默认 20000，网桥读会话会切窗口，不宜过密）
WECHAT_PERSONAL_POLL_MS=20000
EMPLOYEE_HEARTBEAT_TIMEOUT_SECONDS=90
# ---- 联网搜索能力（P11）----
# 供应商：tavily | bing；留空则自动探测（有 TAVILY_API_KEY 用 tavily，否则 bing）
SEARCH_PROVIDER=
TAVILY_API_KEY=
BING_SEARCH_KEY=
# ---- 工作区文件能力（P11）----
# 单文件字节上限（默认 2MB）；文件落 WORKSPACE_DIR（默认 ./uploads/workspace），OSS 齐全时同时上传
WORKSPACE_MAX_BYTES=2000000
# 用户上传资料的字节上限（默认 20MB），含 Excel/Word/PDF/图片/音视频
WORKSPACE_UPLOAD_MAX_BYTES=20971520
WORKSPACE_DIR=
# ---- 更新源 ----
UPDATE_BASE_URL=https://updates.fcmediaagent.com/replica
DEFAULT_UPSTREAM_MODEL=doubao-seed-2-1-pro-260628

# ===== 团队套餐（T-08）=====
# 兑换码核销后的默认有效天数；三档 preset 为 traffic/private-domain/flagship
PACKAGE_VALID_DAYS=30
