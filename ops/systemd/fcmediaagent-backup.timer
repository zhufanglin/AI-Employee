[Unit]
Description=fcmediaagent MySQL 每日 03:30 备份定时器（P44 运维保障 / WP1）

[Timer]
# 每天 03:30（服务器本地时区，生产机 Asia/Shanghai 由 timedatectl 决定）
OnCalendar=*-*-* 03:30:00
# 错峰最多 5 分钟，避免和整点任务同时抢 IO；Persistent 保证关机/重启后补跑
RandomizedDelaySec=300
Persistent=true
Unit=fcmediaagent-backup.service

[Install]
WantedBy=timers.target
